{
  "name": "threadshelf-enhanced-documentation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Static React documentation for ThreadShelf Enhanced",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Davoda1/ThreadShelf-Enhanced-Manual.git"
  },
  "bugs": { "url": "https://github.com/Davoda1/ThreadShelf-Enhanced-Manual/issues" },
  "homepage": "https://github.com/Davoda1/ThreadShelf-Enhanced-Manual#readme",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "develop": "npm run dev",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "check:public": "node scripts/check-public.mjs",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs",
    "verify": "npm run check:public && npm test && npm run build && npm run check"
  },
  "dependencies": {
    "lucide-react": "1.67.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": { "vite": "8.3.5" }
}
